---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { langs, type Lang, type PageKey } from '../../i18n/config';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries
    .map((entry) => {
      const [lang, ...rest] = entry.id.split('/');
      const slug = rest.join('/');
      if (!langs.includes(lang as Lang) || slug === 'home') return null;
      return {
        params: { lang, slug },
        props: { entry },
      };
    })
    .filter((p): p is NonNullable<typeof p> => p !== null);
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const pageKey = entry.data.translationKey as PageKey;
const isAdmission = pageKey === 'admission';
const { Content } = await render(entry);
---

<BaseLayout lang={lang} pageKey={pageKey} title={entry.data.title} description={entry.data.description}>
  <section class="page-section">
    <div class="container">
      <h1 class="page-title">{entry.data.title}</h1>
      {
        isAdmission ? (
          <div class="admission-layout">
            <div class="admission-layout__media">
              <Content />
            </div>
            <div class="admission-layout__form">
              <ContactForm lang={lang} />
            </div>
          </div>
        ) : (
          <article class="prose">
            <Content />
          </article>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .admission-layout {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  .admission-layout__media {
    max-width: 32rem;
  }

  .admission-layout__media :global(img) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .admission-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .admission-layout__media {
      max-width: none;
    }

    .admission-layout :global(.contact-form) {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
