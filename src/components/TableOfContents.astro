---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  label: string;
}

const { headings, label } = Astro.props;

const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/[*_`]/g, '').trim() }));
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={label}>
      <p class="toc__title">{label}</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class={`toc__item toc__item--h${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    max-width: 46rem;
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .toc__title {
    font-family: var(--font-nav-stack);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    margin: 0.15rem 0;
    line-height: 1.4;
  }

  .toc__item a {
    text-decoration: none;
  }

  .toc__item a:hover {
    text-decoration: underline;
  }

  .toc__item--h3 {
    padding-left: 1rem;
    font-size: 0.95rem;
  }
</style>
