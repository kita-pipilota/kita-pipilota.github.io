---
import {
  languages,
  nav,
  pageRegistry,
  localePath,
  alternatePath,
  ui,
  type Lang,
  type PageKey,
} from '../i18n/config';

interface Props {
  lang: Lang;
  pageKey: PageKey;
}

const { lang, pageKey } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'de' ? 'es' : 'de';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(lang, 'home')} aria-label="Pipilota">
      <img src="/images/logosmall.png" alt="Pipilota" width="180" height="60" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="visually-hidden">{t.menu}</span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label={t.menu}>
      <ul class="nav-list">
        {
          nav.map((key) => (
            <li>
              <a href={localePath(lang, key)} aria-current={key === pageKey ? 'page' : undefined}>
                {pageRegistry[key][lang].label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        pageKey !== 'imprint' && (
          <a
            class="lang-switch"
            href={alternatePath(lang, pageKey)}
            hreflang={languages[other].htmlLang}
          >
            {languages[other].label}
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const navEl = header?.querySelector('.primary-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .brand img {
    display: block;
    width: auto;
    height: 3.5rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle__bar {
    width: 26px;
    height: 2px;
    background: var(--color-text);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    font-family: var(--font-nav-stack);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-text);
    padding: 0.25rem 0;
  }

  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--color-accent-dark);
  }

  .lang-switch {
    font-family: var(--font-nav-stack);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-accent-dark);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.4rem 0.8rem;
    white-space: nowrap;
  }

  @media (max-width: 63.99rem) {
    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 1.25rem 1.5rem;
      z-index: 30;
    }

    .primary-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .nav-list a {
      font-size: 0.9rem;
    }

    .lang-switch {
      display: inline-block;
      margin-top: 1rem;
    }
  }
</style>
